    "springy": "cubic-bezier(0.175,0.885,0.32,1.275)",
    "back_js": "1+(s+1)*Math.pow(x-1,3)+s*Math.pow(x-1,2)  // s=2.0 word, s=0.8 title",
    "expo_js": "x===1?1:1-Math.pow(2,-10*x)  // big titles + counters",
    "active_word_scale": 1.10
  },
  "caption_looks": {
    "hormozi": ".cap span{font-size:96px;font-weight:900;color:#fff;text-shadow:-3px 0 #000,3px 0 #000,0 -3px #000,0 3px #000,-3px -3px #000,3px 3px #000,3px -3px #000,-3px 3px #000,0 6px 16px rgba(0,0,0,.6)} .cap span.on{color:#FFD93D;transform:scale(1.10)}",
