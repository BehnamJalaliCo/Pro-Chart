server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;

    client_max_body_size 4m;

    # API — حذفِ پیشوندِ /api و فوروارد به backend (روی همین استکِ standalone، سرویس = api)
    # resolverِ DNSِ داخلیِ داکر + upstreamِ متغیر → بعد از recreateِ api، IPِ تازه دوباره resolve
    # می‌شود و دیگر 502ِ ناشی از IPِ کهنه نمی‌گیریم.
    resolver 127.0.0.11 valid=10s ipv6=off;
    location ~ ^/api(/v1)?/ {
        set $up_api http://api:8000;
        rewrite ^/api(/v1)?/(.*)$ /$2 break;
        proxy_pass $up_api;
        proxy_read_timeout 120s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ⚠️ sw.js و manifest هرگز کش نشوند — وگرنه service worker آپدیت نمی‌شود.
    location = /sw.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Service-Worker-Allowed "/" always;
        expires off;
    }
    location = /manifest.webmanifest {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        expires off;
    }

    # فایل‌های هش‌دار: کشِ بلندمدت
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        expires off;
    }

    location /health { access_log off; return 200 '{"status":"ok"}'; add_header Content-Type application/json; }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
