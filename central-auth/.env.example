# نمونهٔ محیط — کپی به .env و مقداردهی (‏.env در گیت نیست)
# دیتابیسِ مرکزی
DB_HOST=central-postgres
DB_PORT=5432
DB_NAME=central_identity
DB_USER=central
DB_PASSWORD=CHANGE_ME

# کلیدهای RS256 (مسیرِ فایل‌ها؛ با scripts/gen-keys.sh ساخته می‌شوند)
JWT_PRIVATE_KEY_PATH=/app/keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/jwt_public.pem
JWT_KID=central-2026-07
JWT_ISSUER=https://auth.pro-chart.internal
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=7

# سازگاریِ عقب‌رو با توکن‌های HS256 قدیمی (دورهٔ گذار) — همان JWT_SECRET_KEY اپ
LEGACY_HS256_SECRET=CHANGE_ME_SAME_AS_APP
LEGACY_HS256_ENABLED=1

# سقفِ دستگاه‌ها
MAX_DEVICES=2
