# ایمیجِ on-demand برای بک‌تستِ کمی با vectorbt (جدا از تصاویرِ production تا بلوار نشوند).
# نکته: numpy/pandas را pin نمی‌کنیم تا vectorbt/numba نسخه‌های سازگارِ خودشان را بیاورند
# (این ایمیج مستقل است و لازم نیست با numpy 2.2 پروژه هماهنگ باشد).
# ساخت:  docker build -f backtest/Dockerfile.backtest -t coinepro-backtest .
# اجرا:   docker run --rm --network coinepro-network --env-file .env coinepro-backtest \
#            python -m backtest.run_backtest XTIUSD H1 2000
FROM python:3.11-slim

WORKDIR /app
RUN pip install --no-cache-dir \
    "vectorbt==0.26.2" \
    "plotly<5.18" \
    "sqlalchemy>=2.0,<2.1" \
    "psycopg2-binary" \
    "python-dotenv"

COPY backtest /app/backtest

ENTRYPOINT []
CMD ["python", "-m", "backtest.run_backtest", "XTIUSD", "H1"]
