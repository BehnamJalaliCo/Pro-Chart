# configuration file /etc/nginx/conf.d/default.conf:
# ── تشخیصِ خزندهٔ موتورهای جستجو/شبکه‌های اجتماعی برای Dynamic Rendering ──
# خزنده‌ها → HTMLِ پیش‌رندرشدهٔ backend (/seo/render) با متا/JSON-LD کامل؛ کاربرِ واقعی → SPA.
map $http_user_agent $is_crawler {
    default 0;
    "~*(googlebot|google-inspectiontool|storebot-google|adsbot-google|mediapartners-google|bingbot|bingpreview|yandex|duckduckbot|baiduspider|slurp|facebookexternalhit|facebot|twitterbot|linkedinbot|telegrambot|whatsapp|applebot|petalbot|semrushbot|ahrefsbot|mj12bot|dotbot|pinterestbot|pinterest|redditbot|discordbot|embedly|vkshare|ia_archiver)" 1;
}

# HTTP: ACME challenge + redirect to HTTPS
server {
    listen 80;
    server_name pro-chart.ir _;
    include /etc/nginx/prochart-security-headers.conf;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location /health {
        access_log off;
        return 200 '{"status":"ok"}';
        include /etc/nginx/prochart-security-headers.conf;
        add_header Content-Type application/json;
    }
    location / { return 301 https://$host$request_uri; }
}

# HTTPS: the BazaarNama app
server {
    listen 443 ssl;
    http2 on;
    server_name pro-chart.ir _;

    ssl_certificate     /etc/letsencrypt/live/pro-chart.ir/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pro-chart.ir/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    root /usr/share/nginx/html;
    index index.html;
    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml application/xml application/rss+xml;
    client_max_body_size 4m;

    # Browser security boundary. Repeated in locations with add_header via the
    # shared include because nginx otherwise drops inherited server headers.
    include /etc/nginx/prochart-security-headers.conf;

    # Same-origin API responses already have middleware headers. At this edge,
    # suppress those upstream copies so clients receive one deterministic
    # policy rather than duplicate/intersecting header fields.
    proxy_hide_header Strict-Transport-Security;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-XSS-Protection;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header Permissions-Policy;
    proxy_hide_header Content-Security-Policy;

    resolver 127.0.0.11 valid=10s ipv6=off;
    location ~ ^/api(/v1)?/ {
        set $up_api http://api:8000;
        rewrite ^/api(/v1)?/(.*)$ /$2 break;
        proxy_pass $up_api;
        proxy_read_timeout 120s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── SEO: sitemap / robots / indexnow / rss از backend سرو می‌شوند (نه SPA) ──
    location = /robots.txt       { set $up_seo http://api:8000; proxy_pass $up_seo/robots.txt;       proxy_set_header Host $host; }
    location = /sitemap.xml      { set $up_seo http://api:8000; proxy_pass $up_seo/sitemap.xml;      proxy_set_header Host $host; }
    location ~ ^/sitemap-[a-z]+\.xml$ { set $up_seo http://api:8000; proxy_pass $up_seo$uri;         proxy_set_header Host $host; }
    location = /rss.xml          { set $up_seo http://api:8000; proxy_pass $up_seo/rss.xml;          proxy_set_header Host $host; }
    location = /indexnow-key.txt { set $up_seo http://api:8000; proxy_pass $up_seo/indexnow-key.txt; proxy_set_header Host $host; }

    location = /sw.js {
        include /etc/nginx/prochart-security-headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Service-Worker-Allowed "/" always;
        expires off;
    }
    location = /manifest.webmanifest {
        include /etc/nginx/prochart-security-headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        expires off;
    }
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        include /etc/nginx/prochart-security-headers.conf;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location = /index.html {
        include /etc/nginx/prochart-security-headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        expires off;
    }
    location /health {
        access_log off;
        return 200 '{"status":"ok"}';
        include /etc/nginx/prochart-security-headers.conf;
        add_header Content-Type application/json;
    }

    # ── SPA + Dynamic Rendering برای خزنده‌ها ──
    location / {
        error_page 418 = @prerender;
        recursive_error_pages on;
        if ($is_crawler) { return 418; }
        try_files $uri $uri/ /index.html;
    }
    location @prerender {
        set $up_seo http://api:8000;
        proxy_pass $up_seo/seo/render$uri$is_args$args;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 30s;
    }
}

# configuration file /etc/nginx/prochart-security-headers.conf:
# Shared by the HTTPS server and every location that declares its own
# add_header. nginx does not inherit server-level add_header values into such
# locations, so keeping the policy in one include prevents asset/index routes
# from silently dropping the security boundary.

add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
add_header X-Frame-Options "DENY" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-XSS-Protection "0" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), fullscreen=(self), clipboard-write=(self)" always;

# Compatibility exceptions are deliberately narrow and regression-tested:
# - unsafe-eval + blob workers: NamaScript evaluates user formulas only inside
#   its time-limited Web Worker.
# - unsafe-inline styles: React chart components set data-driven inline styles.
# - telegram.org/oauth.telegram.org: the tracked Telegram login widget.
# - https: for images/media: lesson, journal and managed-ad URLs are API data;
#   scripts, frames and network connections remain explicitly constrained.
# The sha256 source is the sole inline JSON-LD block in index.html.
add_header Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-eval' 'sha256-aF/iCowKFbkBQV8blW86a4NG08HFM7xzzyuKi3NeF9c=' https://telegram.org; script-src-attr 'none'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' wss://pro-chart.ir wss://pro-chart.com; frame-src https://oauth.telegram.org; manifest-src 'self'; upgrade-insecure-requests" always;

