API_DOMAIN=api.FX.trade-future.ir

# ── Claude LLM (اشتراک Max، بدون API پولی) ──────────────
# توکن بلندمدت اختصاصیِ کانتینر claude-llm (با `claude setup-token` ساخته می‌شود).
# مستقل از /login هاست است و ~۱ سال اعتبار دارد. با اسکریپت زیر امن ذخیره کن:
#   bash scripts/set_claude_token.sh
CLAUDE_CODE_OAUTH_TOKEN=
LLM_ENABLED=true
LLM_NARRATOR_ENABLED=true
LLM_SANITY_GATE_ENABLED=true
LLM_NEWS_ENABLED=false

# ── انتشارِ خودکارِ ویدیوی آکادمی (یوتیوب/آپارات) ──
ACADEMY_DRIP_ENABLED=false
ACADEMY_SITE_URL=https://fx.trade-future.ir/academy
# یوتیوب (Google Cloud → OAuth2؛ یک‌بار Authorize → refresh_token)
YOUTUBE_ENABLED=false
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PLAYLIST_TITLE=آموزش جامع آکادمی فارکس از مقدماتی تا حرفه‌ای
YOUTUBE_PRIVACY=public

# بلاگ → ویدیوی یوتیوب + شورت (روزی ۲ بار ۹:۰۰ و ۲۰:۰۰ تهران)
BLOG_VIDEO_ENABLED=false
